{
  "name": "markethub-monorepo",
  "version": "1.0.0",
  "description": "MarketHub - Multi-Vendor E-Commerce Marketplace",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:init": "npm run db:init --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "clean:test-products": "node backend/scripts/cleanTestProducts.js && npm run search:reindex",
    "search:reindex": "npm run search:reindex --prefix backend",
    "test": "npm test --prefix backend",
    "test:stage7": "npm run test:stage7 --prefix backend",
    "test:stage8": "npm run test:stage8 --prefix backend",
    "test:stage9": "npm run test:stage9 --prefix backend"
  },
  "keywords": [
    "marketplace",
    "multi-vendor",
    "react",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC"
}
